rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in person can read and write only their own cards and progress.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Card inbox: anyone who knows an inbox key (a long random secret shown in
    // the app) can drop new cards in, for example Claude from a chat. Only the
    // key's owner can read them, and the app moves them into their deck.
    match /inbox/{key}/cards/{id} {
      allow create: if key.size() >= 24
        && request.resource.data.keys().hasOnly(['topic', 'front', 'back', 'createdAt'])
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 100
        && request.resource.data.front is string && request.resource.data.front.size() <= 5000
        && request.resource.data.back is string && request.resource.data.back.size() <= 10000;
      allow read, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/settings/inbox).data.key == key;
    }
  }
}
